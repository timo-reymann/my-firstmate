def cell_width(text: str) -> int:
    """Terminal cells a string takes: wide East Asian characters count two."""
    width = 0
    for char in text:
        if unicodedata.combining(char):
            continue
        width += 2 if unicodedata.east_asian_width(char) in ("W", "F") else 1
    return width


def fit(text: str, width: int, pad: bool = True) -> str:
    """Cut to width cells with an ellipsis, then pad with spaces."""
    if width <= 0:
        return ""
    if cell_width(text) > width:
        out, used = [], 0
        for char in text:
            size = cell_width(char)
            if used + size > width - 1:
                break
            out.append(char)
            used += size
        text = "".join(out) + ELLIPSIS
    return text + " " * (width - cell_width(text)) if pad else text


# --- frame lines (pure) ------------------------------------------------------


class Line:
    """One frame row: (text, role) spans, an optional live-view slot, and a background layer."""

    __slots__ = ("spans", "layer", "selected")

    def __init__(self, layer: Optional[str] = None, selected: bool = False) -> None:
        self.spans: List[Tuple[str, str, int]] = []
        self.layer = layer
        self.selected = selected

    def add(self, text: str, role: str = "fg") -> "Line":
        if text:
            self.spans.append((text, role, -1))
        return self

    def live(self, raw: str, width: int) -> "Line":
        """A slot of width cells that shows one ANSI line of a worker screen."""
        if width > 0:
            self.spans.append((raw, "live", width))
        return self

    def width(self) -> int:
        return sum(
            size if size >= 0 else cell_width(text) for text, _, size in self.spans
        )

    def plain(self) -> str:
        """The text alone; the selection mark shows as "›" because plain text has no fill."""
        return "".join(
            fit(strip_ansi(text), size)
            if size >= 0
            else ("›" if role == "mark" else text)
            for text, role, size in self.spans
        )


ANSI_RE = re.compile(
    r"\x1b\[[0-?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[@-Z\\-_]"
)


def strip_ansi(text: str) -> str:
    return ANSI_RE.sub("", text).replace("\r", "")


def box(
    width: int,
    height: int,
    title: List[Tuple[str, str]],
    right: List[Tuple[str, str]],
    body: List[Line],
    layer: Optional[str] = None,
) -> List[Line]:
    """A rounded box of width x height; body lines are already inner width (width - 2)."""
    if width < 4 or height < 2:
        return []
    top = Line(layer=layer).add("╭─", "dim")
    used = 2
    for text, role in title:
        text = fit(text, max(0, width - 3 - used), pad=False)
        top.add(text, role)
        used += cell_width(text)
    right_width = sum(cell_width(text) for text, _ in right)
    if used + right_width + 2 > width:
        right, right_width = [], 0
    top.add("─" * (width - 1 - used - right_width), "dim")
    for text, role in right:
        top.add(text, role)
    top.add("╮", "dim")
    lines = [top]
    for index in range(height - 2):
        inner = body[index] if index < len(body) else Line()
        # A selected row fills only the inside of the box; the border keeps its colour.
        row = Line(layer=layer).add("│", "dim")
        fill = "selected" if inner.selected else "fg"
        for text, role, size in inner.spans:
            keep = role in ("mark", "live") or not inner.selected
            row.spans.append((text, role if keep else fill, size))
        row.add(" " * max(0, width - 2 - inner.width()), fill)
        row.add("│", "dim")
        lines.append(row)
    lines.append(Line(layer=layer).add("╰" + "─" * (width - 2) + "╯", "dim"))
    return lines


def key_bar(width: int, items: List[Tuple[str, str]]) -> Line:
    """The key bar; items that do not fit drop from the end, but the last item always stays."""

    def size(item: Tuple[str, str]) -> int:
        return cell_width(item[0]) + 1 + cell_width(item[1]) + 2

    keep = list(items[:-1])
    while keep and 1 + sum(size(item) for item in keep) + size(items[-1]) > width:
        keep.pop()
    line = Line(layer="bar").add(" ")
    for key, label in keep + list(items[-1:]):
        if line.width() + size((key, label)) - 2 > width:
            break
        line.add(key, "key").add(" " + label + "  ")
    return line


# --- pure functions: ledger --------------------------------------------------


def _is_number(value: Any) -> bool:
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def parse_ledger_lines(lines: Iterable[str]) -> List[Dict[str, Any]]:
    """Return the known ledger records in file order.

    Blank lines, lines that are not a JSON object, unknown events and records
    without a numeric ts or a task are skipped. Repeated records (the ledger
    delivers at least once) are kept once, keyed on (ts, event, task, text).
    """
    events: List[Dict[str, Any]] = []
    seen = set()
    for line in lines:
        line = line.strip()
        if not line:
            continue
        try:
            record = json.loads(line)
        except ValueError:
            continue
        if not isinstance(record, dict):
            continue
        event = record.get("event")
        task = record.get("task")
        if event not in LEDGER_EVENTS or not isinstance(task, str) or not task:
            continue
        if not _is_number(record.get("ts")):
            continue
        text = record.get("text")
        key = (record["ts"], event, task, text if isinstance(text, str) else None)
        if key in seen:
            continue
        seen.add(key)
        events.append(record)
    return events


def complete_lines(data: bytes, from_start: bool) -> List[str]:
    """Split ledger bytes into complete lines.

    A last line without its newline is still being written and is dropped.
    When the bytes do not start at the beginning of the file, the first line
    is a fragment and is dropped too.
    """
    text = data.decode("utf-8", errors="replace")
    parts = text.split("\n")
    parts.pop()  # the text after the last newline: empty, or a partial line
    if not from_start and parts:
        parts.pop(0)
    return parts


def read_ledger(
    path: str, tail_bytes: int = LEDGER_TAIL_BYTES
) -> Tuple[List[Dict[str, Any]], bool]:
    """Read the ledger tail. Returns (records, present); a missing file is ([], False)."""
    try:
        with open(path, "rb") as handle:
            handle.seek(0, os.SEEK_END)
            size = handle.tell()
            start = max(0, size - tail_bytes)
            handle.seek(start)
            data = handle.read()
    except FileNotFoundError:
        return [], False
    except OSError:
        return [], True
    return parse_ledger_lines(complete_lines(data, start == 0)), True


def format_event(record: Dict[str, Any]) -> str:
    """One-line description of a ledger record; PR URLs stay whole."""
    event = record.get("event")
    if event == "task.dispatched":
        words = ["dispatched"]
        for member in ("kind", "project"):
            value = record.get(member)
            if isinstance(value, str) and value:
                words.append(value)
        harness = record.get("harness")
        if isinstance(harness, str) and harness:
            words.append("(%s)" % harness)
        return " ".join(words)
    if event == "task.status":
        state = record.get("state")
        text = record.get("text")
        text = text.strip() if isinstance(text, str) else ""
        if isinstance(state, str) and state:
            return "%s: %s" % (state, text) if text else state
        return text or "status"
    if event == "task.pr_ready":
        pr = record.get("pr")
        return "PR ready %s" % pr if isinstance(pr, str) and pr else "PR ready"
    if event == "task.merged":
        pr = record.get("pr")
        if record.get("via") == "local":
            return "merged locally"
        return "merged %s" % pr if isinstance(pr, str) and pr else "merged"
    if event == "task.cleaned_up":
        return "cleaned up"
    return str(event)


STATUS_WORDS = {
    "needs-decision": "decision",
    "blocked": "blocked",
    "failed": "failed",
    "working": "working",
    "paused": "paused",
    "done": "done",
}


def event_state(record: Dict[str, Any]) -> str:
    """The state symbol a ledger record shows with."""
    event = record.get("event")
    if event == "task.status":
        return STATUS_WORDS.get(record.get("state") or "", "note")
    if event == "task.pr_ready":
        return "pr"
    if event in ("task.merged", "task.cleaned_up"):
        return "done"
    return "working"


def format_clock(ts: float, now: float) -> str:
    """HH:MM for today, MM-DD HH:MM for older records."""
    stamp = time.localtime(ts)
    if time.strftime("%Y-%m-%d", stamp) == time.strftime(
        "%Y-%m-%d", time.localtime(now)
    ):
        return time.strftime("%H:%M", stamp)
    return time.strftime("%m-%d %H:%M", stamp)


def ledger_kinds(records: List[Dict[str, Any]]) -> Dict[str, str]:
    """Task kinds from the dispatch records, for tasks the snapshot no longer lists."""
    kinds = {}
    for record in records:
        kind = record.get("kind")
        if record.get("event") == "task.dispatched" and isinstance(kind, str):
            kinds[record["task"]] = kind
    return kinds


def merged_tasks(records: List[Dict[str, Any]]) -> set:
    """Tasks whose latest PR record is a merge, so a lingering PR URL is not shown as ready."""
    latest: Dict[str, str] = {}
    for record in records:
        if record.get("event") in ("task.pr_ready", "task.merged"):
            latest[record["task"]] = record["event"]
    return {task for task, event in latest.items() if event == "task.merged"}


def filter_events(
    records: List[Dict[str, Any]], choice: str, selected: Optional[str]
) -> List[Dict[str, Any]]:
    if choice == FILTER_NEEDS:
        return [r for r in records if event_state(r) in NEEDS_YOU]
    if choice == FILTER_TASK and selected:
        return [r for r in records if r["task"] == selected]
    return list(records)


# --- pure functions: snapshot and workers ------------------------------------


def _dig(value: Any, *keys: str) -> Any:
    for key in keys:
        if not isinstance(value, dict):
            return None
        value = value.get(key)
    return value


def _text(value: Any) -> str:
    return value if isinstance(value, str) else ""


def parse_snapshot(text: str) -> Dict[str, Any]:
    """Parse fm-fleet-snapshot JSON into {home, state_dir, config_dir, tasks}.

    Raises ValueError when the text is not a JSON object.
    """
    data = json.loads(text)
    if not isinstance(data, dict):
        raise ValueError("snapshot is not a JSON object")
    tasks = []
    for row in data.get("tasks") or []:
        if not isinstance(row, dict) or not isinstance(row.get("id"), str):
            continue
        hints = row.get("hints") if isinstance(row.get("hints"), dict) else {}
        state = _dig(row, "current_state", "state")
        age = _dig(row, "paths", "status_log", "last_event", "age_seconds")
        decisions = hints.get("open_decisions")
        tasks.append(
            {
                "id": row["id"],
                "kind": _text(row.get("kind")) or "task",
                "project": _text(row.get("project")),
                "raw_state": state if isinstance(state, str) and state else "unknown",
                "age": age if _is_number(age) else None,
                "pr": _text(_dig(row, "pr", "url")),
                "target": _text(_dig(row, "endpoint", "target")),
                "note": _text(hints.get("last_event_text")),
                "decision": hints.get("pending_decision") is True
                or (isinstance(decisions, list) and bool(decisions)),
                "blocked": hints.get("blocked_event") is True or state == "blocked",
            }
        )
    home = _text(data.get("fm_home"))
    roots = data.get("roots") if isinstance(data.get("roots"), dict) else {}
    return {
        "home": home,
        "state_dir": _text(roots.get("state")),
        "config_dir": _text(roots.get("config")),
        "tasks": tasks,
    }


def worker_state(task: Dict[str, Any], merged: Iterable[str] = ()) -> str:
    """The displayed state: decision, blocked, failed, PR ready, then the current state."""
    if task["decision"]:
        return "decision"
    if task["blocked"]:
        return "blocked"
    raw = task["raw_state"]
    if raw == "failed":
        return "failed"
    if task["pr"] and task["id"] not in merged:
        return "pr"
    return raw if raw in ("working", "paused", "parked", "done") else "note"


def attention_key(worker: Dict[str, Any]) -> str:
    """What a "read" mark remembers; a new state, report or PR makes the item unread again."""
    return "%s|%s|%s" % (worker["state"], worker["note"], worker["pr"])


RANKS = {"decision": 0, "blocked": 1, "failed": 1, "pr": 2}
LATER_RANKS = {"working": 10, "paused": 11, "parked": 11, "note": 12, "done": 13}


def build_workers(
    tasks: List[Dict[str, Any]],
    records: List[Dict[str, Any]],
    read: Dict[str, str],
) -> List[Dict[str, Any]]:
    """Snapshot tasks as worker rows, sorted needs-you first (unread before read)."""
    merged = merged_tasks(records)
    workers = []
    for task in tasks:
        worker = dict(task)
        worker["state"] = worker_state(task, merged)
        worker["needs"] = worker["state"] in NEEDS_YOU
        worker["unread"] = worker["needs"] and read.get(task["id"]) != attention_key(
            worker
        )
        worker["quiet"] = (
            worker["state"] == "working"
            and worker["age"] is not None
            and worker["age"] > QUIET_SECONDS
        )
        if worker["needs"]:
            worker["rank"] = RANKS[worker["state"]] + (0 if worker["unread"] else 5)
        else:
            worker["rank"] = LATER_RANKS[worker["state"]]
        workers.append(worker)
    workers.sort(key=lambda w: (w["rank"], w["id"]))
    return workers


def unread_count(workers: List[Dict[str, Any]]) -> int:
    return sum(1 for w in workers if w["unread"])


def format_age(seconds: Optional[float]) -> str:
    if seconds is None or seconds < 0:
        return "-"
    seconds = int(seconds)
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if seconds >= size:
            return "%d%s" % (seconds // size, unit)
    return "%ds" % seconds


def home_name(home: str, fallback: str) -> str:
    return os.path.basename(os.path.normpath(home or fallback)) or "firstmate"


def select_index(workers: List[Dict[str, Any]], selected: Optional[str]) -> int:
    for index, worker in enumerate(workers):
        if worker["id"] == selected:
            return index
    return 0


def next_needs(workers: List[Dict[str, Any]], current: int) -> Optional[int]:
    """The next worker after current that needs you (unread first), wrapping around."""
    count = len(workers)
    for want_unread in (True, False):
        for step in range(1, count + 1):
            index = (current + step) % count
            worker = workers[index]
            if worker["needs"] and (worker["unread"] or not want_unread):
                return index
    return None


# --- pure functions: the shared selection file ------------------------------


def parse_shared(text: str) -> Dict[str, Any]:
    """The shared file's members; anything unreadable falls back to the defaults."""
    shared: Dict[str, Any] = {"selected": None, "filter": FILTER_ALL, "read": {}}
    try:
        data = json.loads(text)
    except ValueError:
        return shared
    if not isinstance(data, dict):
        return shared
    if isinstance(data.get("selected"), str) and data["selected"]:
        shared["selected"] = data["selected"]
    if data.get("filter") in FILTERS:
        shared["filter"] = data["filter"]
    read = data.get("read")
    if isinstance(read, dict):
        shared["read"] = {
            k: v for k, v in read.items() if isinstance(k, str) and isinstance(v, str)
        }
    return shared


def load_shared(path: str) -> Dict[str, Any]:
    try:
        with open(path, encoding="utf-8") as handle:
            return parse_shared(handle.read())
    except (OSError, UnicodeDecodeError):
        return parse_shared("")


def save_shared(path: str, changes: Dict[str, Any], live_ids: Iterable[str]) -> None:
    """Merge changes into the shared file and replace it atomically.

    Read marks of tasks that left the fleet are dropped, so the file stays small.
    """
    shared = load_shared(path)
    shared.update(changes)
    keep = set(live_ids)
    shared["read"] = {k: v for k, v in shared["read"].items() if k in keep}
    shared["v"] = 1
    temp = os.path.join(
        os.path.dirname(path), ".%s.%d.tmp" % (os.path.basename(path), os.getpid())
    )
    with open(temp, "w", encoding="utf-8") as handle:
        json.dump(shared, handle, sort_keys=True)
        handle.write("\n")
    os.replace(temp, path)


# --- render: activity --------------------------------------------------------


def activity_head(choice: str, selected: Optional[str], stale: bool) -> str:
    head = "ACTIVITY · last %d" % ACTIVITY_SIZE
    if choice == FILTER_NEEDS:
        head += " · needs-you"
    elif choice == FILTER_TASK and selected:
        head += " · " + selected
    if stale:
        head += " · stale"
    return head


def needs_badge(width: int, needs: int) -> str:
    if not needs:
        return ""
    return (" NEEDS YOU %d " if width >= 60 else " NEEDS %d ") % needs


def activity_title(
    width: int, choice: str, selected: Optional[str], needs: int, stale: bool
) -> Line:
    """The title as a bare row, for a pane too low for the box."""
    line = Line(layer="panel").add(" ")
    head = activity_head(choice, selected, stale)
    hint = " l full log "
    badge = needs_badge(width, needs)
    room = width - 1 - cell_width(badge) - (cell_width(hint) if width >= 60 else 0) - 1
    line.add(fit(head, max(0, room), pad=False), "title")
    if badge and line.width() + 1 + cell_width(badge) <= width:
        line.add(" ").add(badge, "badge_needs")
    if width >= 60 and line.width() + cell_width(hint) <= width:
        line.add(" " * (width - line.width() - cell_width(hint)))
        line.add(" l", "key").add(" full log ", "dim")
    return line


def event_line(
    record: Dict[str, Any],
    width: int,
    now: float,
    kinds: Dict[str, str],
    clock_width: int,
    task_width: int,
) -> Line:
    state = event_state(record)
    symbol, _, badge = STATES[state]
    needs = state in NEEDS_YOU
    line = Line(layer="panel")
    line.add(NEEDS_BAR if needs else " ", "bar")
    line.add(fit(format_clock(record["ts"], now), clock_width), "dim").add(" ")
    line.add(symbol, badge or state_role(state)).add(" ")
    line.add(
        fit(record["task"], task_width),
        kind_info(kinds.get(record["task"], ""))[2] + "+bold",
    )
    line.add(" ")
    rest = width - line.width()
    line.add(fit(format_event(record), rest, pad=False))
    return line


def render_activity(
    width: int,
    height: int,
    records: List[Dict[str, Any]],
    ledger_present: bool,
    workers: List[Dict[str, Any]],
    shared: Dict[str, Any],
    now: float,
    kinds: Optional[Dict[str, str]] = None,
    stale: bool = False,
) -> List[Line]:
    """The activity pane: a box with the title and the newest events, newest first.

    The box fills the pane height; a pane under 3 rows gets a bare title row instead.
    """
    if width < 1 or height < 1:
        return []
    choice = shared.get("filter", FILTER_ALL)
    selected = shared.get("selected") or (workers[0]["id"] if workers else None)
    needs = unread_count(workers)
    boxed = height >= 3 and width >= 20
    inner = width - 2 if boxed else width
    rows = min(ACTIVITY_SIZE, height - 2 if boxed else height - 1)
    body: List[Line] = []
    if rows > 0 and not ledger_present:
        body.append(Line(layer="panel").add(" " + fit(LEDGER_HINT, inner - 1), "dim"))
    elif rows > 0:
        shown = filter_events(records, choice, selected)[-rows:][::-1]
        if not shown:
            body.append(Line(layer="panel").add(fit(" no events yet", inner), "dim"))
        all_kinds = dict(ledger_kinds(records))
        all_kinds.update({w["id"]: w["kind"] for w in workers})
        if kinds:
            all_kinds.update(kinds)
        if shown:
            clock_width = max(cell_width(format_clock(r["ts"], now)) for r in shown)
            task_width = min(24, max(8, max(cell_width(r["task"]) for r in shown)))
        for record in shown:
            body.append(
                event_line(record, inner, now, all_kinds, clock_width, task_width)
            )
    if not boxed:
        return [activity_title(width, choice, selected, needs, stale)] + body
    for line in body:
        line.layer = "panel"
    title = [(" " + activity_head(choice, selected, stale) + " ", "title")]
    badge = needs_badge(width, needs)
    if badge:
        title += [("─", "dim"), (badge, "badge_needs")]
    right = [(" l", "key"), (" full log ", "dim"), ("─", "dim")] if width >= 60 else []
    return box(width, height, title, right, body, layer="panel")


def full_log_lines(
    records: List[Dict[str, Any]], kinds: Dict[str, str], now: float
) -> List[Line]:
    """Every event in the ledger tail, newest first, as whole lines for the log overlay."""
    lines = []
    for record in reversed(records):
        state = event_state(record)
        symbol, _, badge = STATES[state]
        line = Line()
        line.add(NEEDS_BAR if state in NEEDS_YOU else " ", "bar")
        line.add(format_clock(record["ts"], now), "dim").add(" ")
        line.add(symbol, badge or state_role(state)).add(" ")
        line.add(record["task"], kind_info(kinds.get(record["task"], ""))[2] + "+bold")
        line.add(" " + format_event(record))
        lines.append(line)
    return lines


# --- render: workers ---------------------------------------------------------


def row_start(line: Line, worker: Dict[str, Any], selected: bool) -> None:
    if selected:
        line.spans.append((" ", "mark", -1))
    else:
        line.add(NEEDS_BAR if worker["unread"] else " ", "bar")


def task_column(workers: List[Dict[str, Any]], width: int) -> Tuple[int, bool]:
    """(task column, kind word shown) of the wide list.

    The kind word stays while the task column keeps 12 cells (or the longest
    task, when shorter); a narrower list drops the word and keeps the glyph.
    """
    longest = max([cell_width(w["id"]) for w in workers] or [6])
    with_word = width - ROW_FIXED - KIND_WORD >= min(longest, 12)
    fixed = ROW_FIXED + (KIND_WORD if with_word else 0)
    return max(6, min(longest, width - fixed)), with_word


def worker_row(
    worker: Dict[str, Any],
    width: int,
    selected: bool,
    column: Optional[Tuple[int, bool]] = None,
) -> Line:
    """One row of the wide worker list, width cells; the project follows when there is room."""
    task_width, with_word = column or task_column([worker], width)
    symbol, word, badge = STATES[worker["state"]]
    glyph, kind_word, kind_role = kind_info(worker["kind"])
    line = Line(selected=selected)
    row_start(line, worker, selected)
    line.add(" ")
    line.add(
        symbol, badge if badge and worker["unread"] else state_role(worker["state"])
    )
    line.add(" ").add(glyph, kind_role + "+bold").add(" ")
    if with_word:
        line.add(fit(kind_word, KIND_WORD - 1), kind_role).add(" ")
    line.add(fit(worker["id"], task_width), "fg+bold" if worker["needs"] else "fg")
    line.add(" ")
    role = (
        "working_text" if worker["state"] == "working" else state_role(worker["state"])
    )
    line.add(fit(word or worker["raw_state"], 9), role).add(" ")
    age = format_age(worker["age"]) + (ELLIPSIS if worker["quiet"] else "")
    line.add(fit(age, 5), "decision" if worker["quiet"] else "dim")
    project = os.path.basename(worker["project"].rstrip("/"))
    if project and width - line.width() >= 8:
        line.add(" ").add(fit(project, width - line.width() - 1, pad=False), "dim")
    return line


def rail_row(worker: Dict[str, Any], width: int, selected: bool) -> Line:
    """One row of the narrow rail: bar, state symbol, kind glyph, task."""
    symbol, _, badge = STATES[worker["state"]]
    glyph, _, kind_role = kind_info(worker["kind"])
    line = Line(selected=selected)
    row_start(line, worker, selected)
    line.add(
        symbol, badge if badge and worker["unread"] else state_role(worker["state"])
    )
    line.add(glyph, kind_role + "+bold").add(" ")
    task = worker["id"] + (ELLIPSIS if worker["quiet"] else "")
    line.add(fit(task, width - line.width()), "decision" if worker["quiet"] else "fg")
    return line


def list_window(count: int, rows: int, selected: int) -> range:
    """The rows of the list that are drawn, keeping the selection in view."""
    if count <= rows:
        return range(count)
    start = min(max(0, selected - rows + 1), count - rows)
    return range(start, start + rows)


def list_title(
    workers: List[Dict[str, Any]], word: str, stale: bool
) -> List[Tuple[str, str]]:
    needs = unread_count(workers)
    text = " %s %d" % (word, len(workers))
    if needs and word == "WORKERS":
        text += " · NEEDS YOU %d" % needs
    if stale:
        text += " · stale"
    return [(text + " ", "decision" if needs else "title")]


WIDE_KEYS = [
    ("↑↓", "select"),
    ("⏎", "open"),
    ("l", "log"),
    ("n", "needs-you"),
    ("y", "copy PR"),
    ("?", "keys"),
]
RAIL_KEYS = [("?", "keys"), ("1-9", "tab")]


def live_box(
    width: int,
    height: int,
    worker: Optional[Dict[str, Any]],
    live: Optional[List[str]],
    note: str,
) -> List[Line]:
    """The read-only live view of the selected worker's screen."""
    inner = width - 2
    if worker is None:
        body = [Line().add(fit(" no worker selected", inner), "dim")]
        return box(width, height, [(" live view ", "dim")], [], body)
    glyph, kind_word, kind_role = kind_info(worker["kind"])
    title = [(" " + worker["id"] + " ", kind_role + "+bold")]
    right = [(" live · read-only ", "dim")]
    rows = height - 2
    body: List[Line] = []
    if rows >= 3:
        head = " %s %s · %s" % (glyph, worker["id"], kind_word)
        project = os.path.basename(worker["project"].rstrip("/"))
        if project:
            head += " · " + project
        body.append(Line().add(fit(head, inner), kind_role + "+bold"))
    content = rows - len(body) - (1 if rows >= 2 else 0)
    if content > 0:
        if live:
            for raw in live[-content:]:
                body.append(Line().add(" ").live(raw, inner - 1))
        else:
            body.append(Line().add(fit(" " + note, inner), "dim"))
        while len(body) < rows - 1:
            body.append(Line())
    if rows >= 2:
        body.append(Line().add(fit(" ⏎ open real tab   ⇥ next tab", inner), "dim"))
    return box(width, height, title, right, body)


def render_workers(
    width: int,
    height: int,
    workers: List[Dict[str, Any]],
    selected: int,
    live: Optional[List[str]] = None,
    note: str = "",
    stale: bool = False,
) -> List[Line]:
    """The workers pane: the worker list, the live view when there is room, and the key bar."""
    if width < 1 or height < 1:
        return []
    rail = width < RAIL_WIDTH
    if height == 1:
        title = "".join(text for text, _ in list_title(workers, "WORKERS", stale))
        return [Line().add(fit(title.strip(), width), "title")]
    bar = key_bar(width, RAIL_KEYS if rail else WIDE_KEYS)
    rest = height - 1
    count = len(workers)
    if rest < 3 or width < 4:
        lines = []
        for index in list_window(count, rest, selected):
            if rail:
                lines.append(rail_row(workers[index], width, index == selected))
            else:
                column = task_column(workers, width)
                lines.append(
                    worker_row(workers[index], width, index == selected, column)
                )
        while len(lines) < rest:
            lines.append(Line())
        return lines + [bar]
    # The live view needs a box of at least 5 rows: header, one screen row, footer.
    list_rows = min(max(1, count), max(3, rest // 3))
    show_live = not rail and rest - list_rows - 2 >= 5
    if not show_live:
        list_rows = min(max(1, count), rest - 2)
    body = []
    column = task_column(workers, width - 2)
    for index in list_window(count, list_rows, selected):
        if rail:
            body.append(rail_row(workers[index], width - 2, index == selected))
        else:
            body.append(
                worker_row(workers[index], width - 2, index == selected, column)
            )
    if not workers:
        body.append(Line().add(fit(" no workers", width - 2), "dim"))
    right = [(" ↑↓ move ", "dim")] if not rail else []
    title = list_title(workers, "TABS" if rail else "WORKERS", stale)
    lines = box(width, list_rows + 2, title, right, body)
    remaining = rest - len(lines)
    if show_live:
        worker = workers[selected] if workers else None
        lines += live_box(width, remaining, worker, live, note)
    elif rail and remaining >= 3:
        hints = [
            Line().add(fit(" worker view hidden", width - 2), "dim"),
            Line().add(fit(" in a narrow pane", width - 2), "dim"),
            Line(),
            Line().add(" ⏎", "key").add(fit(" open real tab", width - 4)),
            Line().add(" l", "key").add(fit(" full log", width - 4)),
            Line().add(" n", "key").add(fit(" needs-you", width - 4)),
        ]
        lines += box(width, remaining, [], [], hints)
    while len(lines) < rest:
        lines.append(Line())
    return lines[:rest] + [bar]


def render_pane(
    pane: str,
    width: int,
    height: int,
    snapshot: Dict[str, Any],
    records: List[Dict[str, Any]],
    ledger_present: bool,
    shared: Dict[str, Any],
    now: float,
    live: Optional[List[str]] = None,
    note: str = "",
    stale: bool = False,
) -> List[Line]:
    """One frame of a pane; --pane all stacks the activity over the workers."""
    workers = build_workers(snapshot["tasks"], records, shared.get("read", {}))
    selected = select_index(workers, shared.get("selected"))
    if workers and not shared.get("selected"):
        shared = dict(shared, selected=workers[selected]["id"])
    if pane == "activity":
        return render_activity(
            width, height, records, ledger_present, workers, shared, now, stale=stale
        )
    if pane == "workers":
        return render_workers(width, height, workers, selected, live, note, stale)
    top = min(ACTIVITY_HEIGHT, max(1, height // 3))
    lines = render_activity(
        width, top, records, ledger_present, workers, shared, now, stale=stale
    )
    while len(lines) < top:
        lines.append(Line(layer="panel"))
    return lines + render_workers(
        width, height - top, workers, selected, live, note, stale
    )


def plain_frame(lines: List[Line]) -> str:
    return "\n".join(line.plain().rstrip() for line in lines) + "\n"


