def color_depth(env: Dict[str, str], terminal_colors: Optional[int] = None) -> str:
    """The colour depth: FIRSTMATE_TUI_COLORS, else COLORTERM, TERM and the terminfo count."""
    forced = (env.get("FIRSTMATE_TUI_COLORS") or "").strip().lower()
    if forced in ("24bit", "truecolour"):
        forced = "truecolor"
    if forced in DEPTHS:
        return forced
    if (env.get("COLORTERM") or "").lower() in ("truecolor", "24bit"):
        return "truecolor"
    if "256color" in (env.get("TERM") or ""):
        return "256"
    if terminal_colors is not None:
        if terminal_colors >= 256:
            return "256"
        if 0 < terminal_colors <= 8:
            return "8"
    return "16"


def color_theme(env: Dict[str, str]) -> str:
    """dark or light: FIRSTMATE_TUI_THEME, else the background index in COLORFGBG."""
    forced = (env.get("FIRSTMATE_TUI_THEME") or "").strip().lower()
    if forced in THEMES:
        return forced
    background = (env.get("COLORFGBG") or "").split(";")[-1]
    if background.isdigit() and int(background) in (7, 15):
        return "light"
    return "dark"


def style_for(
    role: str, depth: str, theme: str = "dark", layer: Optional[str] = None
) -> str:
    """The Rich style of a palette role, with the background of a layer when it has none."""
    bold = role.endswith("+bold")
    base = role[: -len("+bold")] if bold else role
    dark, light, c16, c8 = PALETTE.get(base, PALETTE["fg"])
    hex_mode = depth in ("truecolor", "256")
    if hex_mode:
        style = dark if theme == "dark" else light
    else:
        style = c16 if depth == "16" else c8
    if bold and "bold" not in style.split():
        style = ("bold " + style).strip()
    if hex_mode and " on " not in style:
        shade = LAYERS.get(layer or "base", LAYERS["base"])
        style = "%s on %s" % (style, shade[0] if theme == "dark" else shade[1])
    return style.strip()


def state_role(state: str) -> str:
