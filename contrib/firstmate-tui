def herdr_target(target: str) -> Optional[Tuple[str, List[str]]]:
    """(pane id, session flag) of a task endpoint "session:pane", or None."""
    if not target or ":" not in target:
        return None
    session, pane = target.split(":", 1)
    if not session or not pane:
        return None
    return pane, ([] if session == "default" else ["--session", session])


def capture_screen(target: str, herdr_bin: str) -> Tuple[Optional[List[str]], str]:
    """The visible screen of a worker pane as ANSI lines, or (None, reason)."""
    parsed = herdr_target(target)
    if parsed is None:
        return None, "no live view: the worker has no Herdr pane"
    pane, flag = parsed
    try:
        result = subprocess.run(
            [herdr_bin, "pane", "read", pane, "--source", "visible", "--format", "ansi"]
            + flag,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=HERDR_TIMEOUT_SECONDS,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return None, "no live view: herdr is not available"
    if result.returncode != 0:
        return None, "no live view: herdr could not read the pane"
    text = result.stdout.decode("utf-8", errors="replace").replace("\r", "")
    lines = text.split("\n")
    while lines and not strip_ansi(lines[-1]).strip():
        lines.pop()
    if not lines:
        return None, "the worker screen is empty"
    return lines, ""


def jump_to(target: str, herdr_bin: str) -> None:
    """Focus the Herdr tab of a task endpoint ("session:pane"); quiet on any failure."""
    parsed = herdr_target(target)
    if parsed is None:
        return
    pane, flag = parsed
    try:
        got = subprocess.run(
            [herdr_bin, "pane", "get", pane] + flag,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=HERDR_TIMEOUT_SECONDS,
            check=False,
        )
        tab = _dig(json.loads(got.stdout or b"{}"), "result", "pane", "tab_id")
        if isinstance(tab, str) and tab:
            subprocess.run(
                [herdr_bin, "tab", "focus", tab] + flag,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=HERDR_TIMEOUT_SECONDS,
                check=False,
            )
    except (OSError, ValueError, subprocess.SubprocessError):
        return


CLIPBOARD_COMMANDS = (
    ["pbcopy"],
    ["wl-copy"],
    ["xclip", "-selection", "clipboard"],
    ["xsel", "--clipboard", "--input"],
)


def copy_text(text: str) -> bool:
    """Copy through the first clipboard tool on PATH; False when there is none."""
    for argv in CLIPBOARD_COMMANDS:
        if shutil.which(argv[0]) is None:
            continue
        try:
            result = subprocess.run(
                argv,
                input=text.encode("utf-8"),
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=HERDR_TIMEOUT_SECONDS,
                check=False,
            )
        except (OSError, subprocess.SubprocessError):
            continue
        if result.returncode == 0:
            return True
    return False


def terminal_colors() -> Optional[int]:
    try:
        import curses

        curses.setupterm()
        return curses.tigetnum("colors")
    except Exception:  # noqa: BLE001 - any terminfo failure means "unknown"
        return None


