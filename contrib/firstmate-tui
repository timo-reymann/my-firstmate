def to_rich(lines: List[Line], width: int, depth: str, theme: str) -> Any:
    """Frame lines as one Rich Text, padded to width so the background layers fill."""
    from rich.text import Text

    out = Text(no_wrap=True, overflow="crop")
    for number, line in enumerate(lines):
        if number:
            out.append("\n")
        for text, role, size in line.spans:
            if line.selected or role == "mark":
                role = "selected"
            style = style_for(
                role if role != "live" else "fg", depth, theme, line.layer
            )
            if size >= 0:
                piece = Text.from_ansi(text, no_wrap=True)
                piece.truncate(size, overflow="crop", pad=True)
                if line.selected:
                    piece.stylize(style)
                out.append_text(piece)
            else:
                out.append(text, style=style)
        pad = width - line.width()
        if pad > 0:
            role = "selected" if line.selected else "fg"
            out.append(" " * pad, style=style_for(role, depth, theme, line.layer))
    return out


def build_app(
    home: str,
    env: Dict[str, str],
    interval: float,
    pane: str = "all",
    depth: Optional[str] = None,
    theme: Optional[str] = None,
) -> Any:
    """Build the Textual app; Textual is imported only here, so --once and the pure functions need none."""
    from rich.text import Text
    from textual import work
    from textual.app import App, ComposeResult
    from textual.binding import Binding
    from textual.containers import VerticalScroll
    from textual.screen import ModalScreen
    from textual.widgets import Static

    herdr_bin = env.get("HERDR_BIN") or "herdr"
    depth = depth or color_depth(env, terminal_colors())
    theme = theme or color_theme(env)
    hex_mode = depth in ("truecolor", "256")
    base = LAYERS["base"][0 if theme == "dark" else 1]
    background = base if hex_mode else "ansi_default"
    help_text = __doc__.split("Keys:\n", 1)[1].split("\n\nEnvironment:", 1)[0]

    class Overlay(ModalScreen):
        """A full-screen read-only overlay: the full log or the key list."""

        CSS = (
            """
        Overlay { align: center middle; background: %s; }
        #overlay { width: 100%%; height: 100%%; border: round $accent; padding: 0 1; }
        """
            % background
        )
        BINDINGS = [
            Binding("escape", "close", "close"),
            Binding("q", "close", show=False),
            Binding("l", "close", show=False),
            Binding("question_mark", "close", show=False),
        ]

        def __init__(self, title: str, body: Any) -> None:
            super().__init__()
            self.title_text = title
            self.body = body

        def compose(self) -> ComposeResult:
            scroll = VerticalScroll(Static(self.body), id="overlay")
            scroll.border_title = self.title_text
            scroll.border_subtitle = "escape closes"
            yield scroll

        def action_close(self) -> None:
            self.dismiss()

    class FirstmateApp(App):
        TITLE = "firstmate"
        CSS = (
            """
        Screen { background: %s; overflow: hidden; }
        #frame { width: 100%%; height: 100%%; }
        """
            % background
        )
        BINDINGS = [
            Binding("up,k", "move(-1)", "up", show=False),
            Binding("down,j", "move(1)", "down", show=False),
            Binding("tab", "next", "next", show=False, priority=True),
            Binding("enter", "open", "open", show=False),
            Binding("l", "log", "log", show=False),
            Binding("n", "needs", "needs-you", show=False),
            Binding("a", "filter('all')", "all", show=False),
            Binding("t", "filter('task')", "this task", show=False),
            Binding("y", "copy", "copy PR", show=False),
            Binding("m", "mark", "mark read", show=False),
            Binding("question_mark", "help", "keys", show=False),
            Binding("r", "refresh", "refresh", show=False),
            Binding("q", "quit", "quit", show=False),
        ] + [Binding(str(n), "pick(%d)" % n, str(n), show=False) for n in range(1, 10)]

        def __init__(self) -> None:
            super().__init__(ansi_color=not hex_mode)
            self.pane = pane
            self.snapshot: Optional[Dict[str, Any]] = None
            self.records: List[Dict[str, Any]] = []
            self.ledger_present = True
            self.stale = False
            self.shared = parse_shared("")
            self.shared_stamp: Optional[float] = None
            self.rows: List[Dict[str, Any]] = []
            self.selected = 0
            self.live: Optional[List[str]] = None
            self.live_for = ""
            self.note = "loading the worker screen"

        def compose(self) -> ComposeResult:
            yield Static("firstmate - loading", id="frame")

        def on_mount(self) -> None:
            if not hex_mode:
                self.theme = "ansi-light" if theme == "light" else "ansi-dark"
            self.action_refresh()
            self.set_interval(interval, self.action_refresh)
            self.set_interval(LIVE_INTERVAL, self.tick)

        # data

        def shared_file(self) -> str:
            return shared_path(self.snapshot or {"state_dir": ""}, home)

        @work(thread=True, exclusive=True, group="snapshot")
        def action_refresh(self) -> None:
            try:
                snapshot = parse_snapshot(run_snapshot(home, env))
            except (OSError, ValueError, RuntimeError, subprocess.SubprocessError):
                self.call_from_thread(self.show, None, [], self.ledger_present)
                return
            records, present = read_ledger(ledger_path(snapshot, home))
            self.call_from_thread(self.show, snapshot, records, present)

        def show(
            self,
            snapshot: Optional[Dict[str, Any]],
            records: List[Dict[str, Any]],
            present: bool,
        ) -> None:
            if snapshot is None:
                self.stale = True
            else:
                self.snapshot, self.records, self.ledger_present = (
                    snapshot,
                    records,
                    present,
                )
                self.stale = False
                self.reload_shared()
            self.redraw()

        def reload_shared(self) -> bool:
            path = self.shared_file()
            try:
                stamp: Optional[float] = os.stat(path).st_mtime_ns
            except OSError:
                stamp = None
            if stamp == self.shared_stamp:
                return False
            self.shared_stamp = stamp
            self.shared = load_shared(path)
            return True

        def write_shared(self, **changes: Any) -> None:
            self.shared.update(changes)
            if self.snapshot is None:
                return
            ids = [t["id"] for t in self.snapshot["tasks"]]
            try:
                save_shared(self.shared_file(), changes, ids)
                self.shared_stamp = os.stat(self.shared_file()).st_mtime_ns
            except OSError:
                self.notify(
                    "could not write %s" % self.shared_file(), severity="warning"
                )

        def tick(self) -> None:
            if self.snapshot is not None and self.reload_shared():
                self.redraw()
            if self.pane != "activity":
                self.capture()

        @work(thread=True, exclusive=True, group="live")
        def capture(self) -> None:
            worker = self.current()
            if worker is None or self.size.width < RAIL_WIDTH:
                return
            lines, note = capture_screen(worker["target"], herdr_bin)
            self.call_from_thread(self.show_live, worker["id"], lines, note)

        def show_live(self, task: str, lines: Optional[List[str]], note: str) -> None:
            self.live, self.note, self.live_for = lines, note, task
            self.redraw()

        def current(self) -> Optional[Dict[str, Any]]:
            if not self.rows:
                return None
            return self.rows[min(self.selected, len(self.rows) - 1)]

        # drawing

        def on_resize(self) -> None:
            self.redraw()

        def redraw(self) -> None:
            width, height = self.size.width, self.size.height
            snapshot = self.snapshot or {"home": "", "state_dir": "", "tasks": []}
            self.rows = build_workers(
                snapshot["tasks"], self.records, self.shared["read"]
            )
            self.selected = select_index(self.rows, self.shared.get("selected"))
            worker = self.current()
            live, note = self.live, self.note
            if worker is None or worker["id"] != self.live_for:
                live, note = None, "loading the worker screen"
            frame = render_pane(
                self.pane,
                width,
                height,
                snapshot,
                self.records,
                self.ledger_present,
                self.shared,
                time.time(),
                live,
                note,
                self.stale,
            )
            self.query_one("#frame", Static).update(to_rich(frame, width, depth, theme))

        # keys

        def select(self, index: int) -> None:
            if not self.rows:
                return
            index = max(0, min(index, len(self.rows) - 1))
            self.write_shared(selected=self.rows[index]["id"])
            self.redraw()
            if self.pane != "activity":
                self.capture()

        def action_move(self, delta: int) -> None:
            self.select(self.selected + delta)

        def action_next(self) -> None:
            if self.rows:
                self.select((self.selected + 1) % len(self.rows))

        def action_pick(self, number: int) -> None:
            if number <= len(self.rows):
                self.select(number - 1)

        def action_open(self) -> None:
            worker = self.current()
            if worker is not None:
                jump_to(worker["target"], herdr_bin)

        def action_filter(self, choice: str) -> None:
            self.write_shared(filter=choice)
            self.redraw()

        def action_needs(self) -> None:
            self.write_shared(filter=FILTER_NEEDS)
            index = next_needs(self.rows, self.selected) if self.rows else None
            if index is not None and self.pane != "activity":
                self.select(index)
            else:
                self.redraw()

        def action_copy(self) -> None:
            worker = self.current()
            if worker is None or not worker["pr"]:
                self.notify("no PR for the selected worker")
                return
            if not copy_text(worker["pr"]):
                self.copy_to_clipboard(worker["pr"])
            self.notify("copied " + worker["pr"])

        def action_mark(self) -> None:
            worker = self.current()
            if worker is None or not worker["unread"]:
                return
            read = dict(self.shared["read"])
            read[worker["id"]] = attention_key(worker)
            self.write_shared(read=read)
            self.redraw()

        def action_log(self) -> None:
            kinds = ledger_kinds(self.records)
            kinds.update({w["id"]: w["kind"] for w in self.rows})
            lines = full_log_lines(self.records, kinds, time.time())
            if not self.ledger_present:
                body: Any = Text(LEDGER_HINT)
            elif not lines:
                body = Text("no events yet")
            else:
                body = to_rich(lines, 0, depth, theme)
                body.no_wrap = False
            self.push_screen(Overlay("ACTIVITY · full log", body))

        def action_help(self) -> None:
            self.push_screen(Overlay("keys", Text(help_text)))

    return FirstmateApp()


def main(argv: Optional[List[str]] = None) -> int:
    # The module docstring is the help text, so --help and the file header never drift.
    parser = argparse.ArgumentParser(prog="firstmate-tui", add_help=False)
    parser.add_argument("-h", "--help", action="store_true")
    parser.add_argument("--pane", choices=PANES, default="all")
    parser.add_argument("--once", action="store_true")
    parser.add_argument("--interval", type=float, default=DEFAULT_INTERVAL)
    parser.add_argument("--width", type=int, default=0)
    parser.add_argument("--height", type=int, default=0)
    args = parser.parse_args(argv)
    if args.help:
        sys.stdout.write(__doc__)
        return 0
    if args.interval <= 0:
        parser.error("--interval must be positive")
    env = dict(os.environ)
    home = firstmate_dir(env)
    if args.once:
        try:
            snapshot = parse_snapshot(run_snapshot(home, env))
        except (OSError, RuntimeError, subprocess.SubprocessError):
            print("firstmate-tui: snapshot failed", file=sys.stderr)
            return 1
        except ValueError:
            print("firstmate-tui: snapshot is not valid JSON", file=sys.stderr)
            return 1
        records, present = read_ledger(ledger_path(snapshot, home))
        shared = load_shared(shared_path(snapshot, home))
        size = shutil.get_terminal_size((80, 24))
        width = max(20, args.width or size.columns)
        default_height = ACTIVITY_HEIGHT if args.pane == "activity" else size.lines
        height = max(1, args.height or default_height)
        live, note = None, ""
        if args.pane != "activity" and width >= RAIL_WIDTH:
            workers = build_workers(snapshot["tasks"], records, shared["read"])
            if workers:
                worker = workers[select_index(workers, shared["selected"])]
                live, note = capture_screen(
                    worker["target"], env.get("HERDR_BIN") or "herdr"
                )
        frame = render_pane(
            args.pane,
            width,
            height,
            snapshot,
            records,
            present,
            shared,
            time.time(),
            live,
            note,
        )
        sys.stdout.write(plain_frame(frame))
        return 0
    if not sys.stdout.isatty():
        print(
            "firstmate-tui: no terminal; use --once for a plain frame", file=sys.stderr
        )
        return 2
    build_app(home, env, args.interval, args.pane).run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
