#!/usr/bin/env bash
# One command for firstmate in Herdr: one tab with the activity across the top, the first mate bottom left,
# and the workers bottom right; the activity and workers panes run firstmate-tui through uv.
# Env overrides: FIRSTMATE_DIR, FIRSTMATE_BIN, TUI_BIN, HERDR_BIN, FM_HERDR_SESSION (named session; default if unset).
set -u

usage() {
  cat <<'USAGE'
Usage: firstmate-herdr [--no-attach] [--check] [--ratio SHARE] [--activity-ratio SHARE] [first mate arguments...]
  One tab holds three panes: the activity across the top, the first mate
  bottom left, and the workers bottom right (both views are firstmate-tui).
  Inside Herdr: builds the layout around the current pane, then runs the first mate here.
  Outside Herdr: builds a "firstmate-screen" workspace in the session, then attaches to it;
  the workers keep their own "firstmate" workspace.
  The first mate pane runs "firstmate --plain"; FIRSTMATE_FORCE=1 starts it despite a live session.
  When another first mate session holds the home lock, the left pane says which pid
  and how to start the first mate there instead.
  --no-attach             build the layout and stop (outside Herdr only)
  --check                 check that Herdr, jq, uv and firstmate-tui are usable, print why not, and stop
  --ratio SHARE           share of the width for the first mate pane (default 0.6)
  --activity-ratio SHARE  share of the height for the activity pane (default 0.28)
USAGE
}

here=$(cd "$(dirname "$0")" && pwd)
dir="${FIRSTMATE_DIR:-$HOME/workspace/firstmate}"
firstmate_bin="${FIRSTMATE_BIN:-$here/firstmate}"
tui_bin="${TUI_BIN:-$here/firstmate-tui}"
herdr_bin="${HERDR_BIN:-herdr}"
session="${FM_HERDR_SESSION:-}"
ratio=0.6
activity_ratio=0.28
attach=1
check=0
label=firstmate-workers
activity_label=firstmate-activity
# The workers run in the "firstmate" workspace (bin/backends/herdr.sh), so the screen needs its own label.
workspace_label=firstmate-screen

while [ $# -gt 0 ]; do
  case "$1" in
    --no-attach) attach=0; shift ;;
    --check) check=1; shift ;;
    --ratio) ratio="${2:?--ratio needs a value}"; shift 2 ;;
    --activity-ratio) activity_ratio="${2:?--activity-ratio needs a value}"; shift 2 ;;
    -h | --help) usage; exit 0 ;;
    --) shift; break ;;
    *) break ;;
  esac
done

die() { echo "firstmate-herdr: $*" >&2; exit 1; }

command -v "$herdr_bin" >/dev/null 2>&1 || die "herdr is not installed (https://herdr.dev)"
command -v jq >/dev/null 2>&1 || die "jq is required"
[ -d "$dir" ] || die "firstmate folder not found: $dir"

uv_bin=$(command -v uv 2>/dev/null || true)
[ -n "$uv_bin" ] || die "the firstmate screen runs firstmate-tui, which needs uv on PATH; install it with: curl -LsSf https://astral.sh/uv/install.sh | sh (see https://docs.astral.sh/uv/)"
[ -f "$tui_bin" ] || die "firstmate-tui not found: $tui_bin"

protocol=$("$herdr_bin" status client 2>/dev/null | awk '/protocol:/ {print $2; exit}')
case "${protocol:-0}" in
  '' | *[!0-9]*) protocol=0 ;;
esac
[ "$protocol" -ge 14 ] || die "herdr protocol 14 or newer is required (found ${protocol:-none}); see https://herdr.dev"
[ "$check" = 0 ] || exit 0

sflag=()
inside=0
if [ "${HERDR_ENV:-}" = 1 ] && [ -n "${HERDR_PANE_ID:-}" ] && [ -z "$session" ]; then
  inside=1
elif [ -n "$session" ] && [ "$session" != default ]; then
  sflag=(--session "$session")
fi

hr() { "$herdr_bin" "$@" ${sflag[@]+"${sflag[@]}"}; }

# The views use the same herdr binary as the launcher, for the live view and the tab jump.
view_env="FIRSTMATE_DIR=$(printf '%q' "$dir")"
[ -z "${HERDR_BIN:-}" ] || view_env="$view_env HERDR_BIN=$(printf '%q' "$HERDR_BIN")"
# The pane shell may have another PATH, so the TUI runs through the uv found here.
tui_cmd="$view_env exec $(printf '%q' "$uv_bin") run --script $(printf '%q' "$tui_bin")"
workers_cmd="$tui_cmd --pane workers"
activity_cmd="$tui_cmd --pane activity"
# No exec: when the first mate stops or refuses to start, its pane keeps the message and a shell.
# --plain keeps firstmate from handing over to this screen again.
mate_cmd="$(printf '%q' "$firstmate_bin") --plain"
for a in "$@"; do mate_cmd="$mate_cmd $(printf '%q' "$a")"; done
# A pane shell does not inherit this environment, so the first mate settings that are set go with the command.
mate_env=""
for v in FIRSTMATE_DIR FIRSTMATE_AGENT FIRSTMATE_FORCE FIRSTMATE_MAX_AGE_MIN FIRSTMATE_PROMPT CLAUDE_CONFIG_DIR XDG_CONFIG_HOME; do
  [ -z "${!v:-}" ] || mate_env="$mate_env$v=$(printf '%q' "${!v}") "
done

# lock_holder: the pid of a live session that holds the home lock (line 1 of state/.lock), or nothing.
# FIRSTMATE_FORCE skips the lock, as it does for firstmate.
lock_holder() {
  local pid
  [ -z "${FIRSTMATE_FORCE:-}" ] || return 0
  [ -r "$dir/state/.lock" ] || return 0
  pid=$(head -n 1 "$dir/state/.lock" 2>/dev/null)
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null && printf '%s' "$pid"
  return 0
}

# lock_line <pid>: the one line shown instead of the first mate while another session holds the lock.
lock_line() {
  printf 'firstmate-herdr: the first mate already runs as pid %s; quit it there, then run %s here (or FIRSTMATE_FORCE=1 %s for a second one).' \
    "$1" "$mate_cmd" "$mate_cmd"
}

# start_mate <pane>: runs the first mate in the pane, or shows the lock line there.
start_mate() {
  local holder
  holder=$(lock_holder)
  if [ -n "$holder" ]; then
    run_when_ready "$1" "printf '%s\\n' $(printf '%q' "$(lock_line "$holder")")"
  else
    run_when_ready "$1" "$mate_env$mate_cmd"
  fi
}

# A new pane shell drops input typed before its startup ends, so prove it reads input first.
# The typed echo never contains the marker; only the executed command prints it.
run_when_ready() {
  local pane=$1 cmd=$2 i
  for i in $(seq 1 25); do
    # shellcheck disable=SC2016
    hr pane run "$pane" 'echo FM_READY_$((40+2))' >/dev/null
    # Herdr 0.9 names the wait "pane wait-output"; older releases call it "wait output".
    { hr pane wait-output "$pane" --match FM_READY_42 --timeout 800 >/dev/null 2>&1 ||
      hr wait output "$pane" --match FM_READY_42 --timeout 800 >/dev/null 2>&1; } && break
    [ "$i" -lt 25 ] || die "the shell in pane $pane did not become ready"
  done
  hr pane run "$pane" "clear; $cmd" >/dev/null
}

# Herdr reads --ratio as the share kept by the original pane, not by the new one.
split() {
  local new
  new=$(hr pane split "$1" --direction "$2" --ratio "$3" --no-focus | jq -r '.result.pane.pane_id // empty')
  [ -n "$new" ] || die "could not split the pane"
  printf '%s' "$new"
}

# Herdr splits only right or down, so the activity pane is split off below and swapped to the top.
build() {
  local mate=$1 activity workers
  activity=$(split "$mate" down "$activity_ratio") || exit 1
  hr pane swap --source-pane "$mate" --target-pane "$activity" >/dev/null || die "could not move the activity pane to the top"
  workers=$(split "$mate" right "$ratio") || exit 1
  hr pane rename "$activity" "$activity_label" >/dev/null
  hr pane rename "$workers" "$label" >/dev/null
  run_when_ready "$activity" "$activity_cmd"
  run_when_ready "$workers" "$workers_cmd"
}

if [ "$inside" = 1 ]; then
  have=$(hr pane list --workspace "${HERDR_WORKSPACE_ID:-}" |
    jq -r --arg tab "${HERDR_TAB_ID:-}" --arg label "$label" \
      '.result.panes[]? | select(.tab_id == $tab and .label == $label) | .pane_id' | head -n 1)
  [ -n "$have" ] || build "$HERDR_PANE_ID"
  holder=$(lock_holder)
  [ -z "$holder" ] || { lock_line "$holder" >&2; echo >&2; exit 1; }
  eval "exec $mate_cmd"
fi

server_running() {
  hr status --json 2>/dev/null | jq -e '.server.running == true' >/dev/null 2>&1
}

if ! server_running; then
  if [ -n "$session" ] && [ "$session" != default ]; then
    HERDR_SESSION="$session" nohup "$herdr_bin" server --session "$session" </dev/null >/dev/null 2>&1 &
  else
    nohup "$herdr_bin" server </dev/null >/dev/null 2>&1 &
  fi
  disown 2>/dev/null || true
  for _ in $(seq 1 50); do
    server_running && break
    sleep 0.2
  done
  server_running || die "the herdr server did not start within 10 seconds"
fi

ws=$(hr workspace list | jq -r --arg label "$workspace_label" \
  '.result.workspaces[]? | select(.label == $label) | .workspace_id' | head -n 1)

if [ -z "$ws" ]; then
  created=$(hr workspace create --cwd "$dir" --label "$workspace_label" --no-focus)
  ws=$(printf '%s' "$created" | jq -r '.result.workspace.workspace_id // empty')
  root=$(printf '%s' "$created" | jq -r '.result.root_pane.pane_id // empty')
  [ -n "$ws" ] && [ -n "$root" ] || die "could not create the workspace"
  build "$root"
  start_mate "$root"
fi

hr workspace focus "$ws" >/dev/null
[ "$attach" = 1 ] || exit 0

if [ ${#sflag[@]} -gt 0 ]; then
  exec env HERDR_SESSION="$session" "$herdr_bin" "${sflag[@]}"
fi
exec "$herdr_bin"
