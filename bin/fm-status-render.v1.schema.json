{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fm-status-render.v1",
  "title": "fm-status-render input, version 1",
  "description": "End-of-turn work list: an optional outcome summary plus titled groups of items that bin/fm-status-render.sh renders as indented lines.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "groups"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\x00-\\x20\\x7f]([^\\x00-\\x1f\\x7f]*[^\\x00-\\x20\\x7f])?$",
      "description": "one line of text with no control characters and no leading or trailing space",
      "maxLength": 140
    },
    "groups": {
      "description": "titled groups; the renderer puts groups with an action item first, then groups with a blocked item, then the rest, in input order within each tier",
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "items"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\x00-\\x20\\x7f]([^\\x00-\\x1f\\x7f]*[^\\x00-\\x20\\x7f])?$",
            "description": "one line of text with no control characters and no leading or trailing space",
            "maxLength": 50
          },
          "items": {
            "description": "one to three items; the renderer orders them action, blocked, finalizing, pending",
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "label"
              ],
              "properties": {
                "status": {
                  "description": "action = needs the reader's decision or action; blocked = stuck; finalizing = nearly done; pending = waiting on something external",
                  "enum": [
                    "action",
                    "pending",
                    "finalizing",
                    "blocked"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\x00-\\x20\\x7f]([^\\x00-\\x1f\\x7f]*[^\\x00-\\x20\\x7f])?$",
                  "description": "one line of text with no control characters and no leading or trailing space",
                  "maxLength": 60
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\x00-\\x20\\x7f]([^\\x00-\\x1f\\x7f]*[^\\x00-\\x20\\x7f])?$",
                  "description": "one line of text with no control characters and no leading or trailing space",
                  "maxLength": 100
                },
                "url": {
                  "description": "a full https URL with a host, no credentials, and no whitespace; printed exactly as given",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300,
                  "pattern": "^https://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]{1,5})?([/?#][^\\x00-\\x20\\x7f]*)?$"
                }
              },
              "allOf": [
                {
                  "description": "an action line shows no note",
                  "if": {
                    "properties": {
                      "status": {
                        "const": "action"
                      }
                    },
                    "required": [
                      "status"
                    ]
                  },
                  "then": {
                    "properties": {
                      "note": false
                    }
                  }
                },
                {
                  "description": "pending, finalizing, and blocked lines need a note",
                  "if": {
                    "properties": {
                      "status": {
                        "enum": [
                          "pending",
                          "finalizing",
                          "blocked"
                        ]
                      }
                    },
                    "required": [
                      "status"
                    ]
                  },
                  "then": {
                    "required": [
                      "note"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
